# ─────────────────────────────────────────────────────────────────────────────
# IIITL FM — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API

# Public project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe to expose to browser — secured by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to browser or client code
# Only used in Server Actions and Route Handlers for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used for OAuth redirect and metadata
# Development: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Spotify Web API ────────────────────────────────────────────────────────────
# Required for Spotify track link submission (Phase 8A).
# Create a free app at: https://developer.spotify.com/dashboard
# Use the Client Credentials flow — NO user login required.
# NEVER expose these to the browser. Server-only.
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here

# ── YouTube Data API v3 ────────────────────────────────────────────────────────
# Required for YouTube video search when a Spotify URL is submitted.
# Create a key at: https://console.cloud.google.com → APIs → YouTube Data API v3
# Enable the API, then create an API key. Restrict it to YouTube Data API v3.
# Free quota: 100 search.list calls/day (sufficient for campus use).
# NEVER expose this to the browser. Server-only.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here
