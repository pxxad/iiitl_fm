# ─────────────────────────────────────────────────────────────────────────────
# IIITL FM — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API

# Public project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe to expose to browser — secured by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to browser or client code
# Only used in Server Actions and Route Handlers for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used for OAuth redirect and metadata
# Development: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
